@page "/agents/{InstallationId:guid}/harness"
@using CSweet.Contracts.Agents
@using WorkspaceResponse = CSweet.Contracts.Agents.HarnessWorkspace
@inject HttpClient Http
@inject AppRealtimeState Realtime
@implements IDisposable
<PageTitle>Agent workspace</PageTitle>
<main class="harness-page">
    <header class="harness-heading"><div><span class="harness-eyebrow">Agent controls</span><h1>Execution workspace</h1><p>Inspect readiness, choose models and pin the skills this agent uses.</p></div><button class="harness-button" @onclick="LoadAsync" disabled="_busy">Refresh</button></header>
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    @if (_notice is not null) { <MudAlert Severity="Severity.Success">@_notice</MudAlert> }
    @if (_changedElsewhere) { <MudAlert Severity="Severity.Info">This agent's policy or skills changed in another session. <button class="harness-button" @onclick="LoadAsync" disabled="@_busy">Reload</button> Unsaved edits here will be replaced.</MudAlert> }
    @if (_workspace is { } workspace)
    {
        <MudTabs KeepPanelsAlive="true" Rounded="true" Elevation="0">
            <MudTabPanel Text="Doctor" Icon="@Icons.Material.Outlined.HealthAndSafety">
                <p class="harness-description">Read-only checks · @workspace.CheckedAt.ToLocalTime().ToString("g")</p>
                <div class="doctor-grid">
                    @foreach (var finding in workspace.Findings)
                    {
                        <article class="doctor-card"><span class="doctor-state @finding.State.ToLowerInvariant()">@finding.State</span><h2>@finding.Title</h2><p>@finding.Detail</p><a href="@finding.RepairUrl">Open settings <span aria-hidden="true">↗</span></a></article>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Models & budgets" Icon="@Icons.Material.Outlined.Tune">
                <section class="harness-section"><h2>Context efficiency</h2><p>Compact exact repeated tool results within a request. Recent results and tool-call structure remain intact. No results are cached across work or reused as current source state.</p>
                    <MudSwitch T="bool" @bind-Value="_compact" Label="Compact duplicate context" />
                </section>
                <section class="harness-section"><h2>Shared task ceilings</h2><p>Canonical child work and retries share the root task account. Failed calls with unknown usage retain their reservation. Blank fields leave that ceiling unset.</p>
                    <div class="harness-fields"><MudNumericField T="long?" @bind-Value="_tokens" Label="Task token ceiling" Min="1" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="_cost" Label="Task cost ceiling (USD)" Min="0.000001m" Variant="Variant.Outlined" /></div>
                </section>
                <section class="harness-section"><h2>Stage routes</h2><p>Use Default for ordinary work, Judgment for advisory evaluations, or an exact orchestration stage key. Saving approves these provider/model pairs, and their fallbacks, for this installation. Fallbacks are tried in order only when the previous target is unavailable before any output; each attempt is reserved against the task budget at its own price.</p>
                    @foreach (var route in _routes)
                    {
                        <div class="route-fields" @key="route"><MudTextField @bind-Value="route.Stage" Label="Stage key" Variant="Variant.Outlined" /><MudSelect T="Guid" @bind-Value="route.Provider" Label="Provider" Variant="Variant.Outlined">@foreach (var provider in workspace.Providers) { <MudSelectItem T="Guid" Value="provider.Id">@provider.Name</MudSelectItem> }</MudSelect><MudTextField @bind-Value="route.Model" Label="Model" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="route.Input" Min="0" Label="Input $ / 1M" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="route.Output" Min="0" Label="Output $ / 1M" Variant="Variant.Outlined" /><button class="harness-button" @onclick="() => _routes.Remove(route)" aria-label="Remove route">Remove</button></div>
                        @foreach (var fallback in route.Fallbacks)
                        {
                            <div class="route-fields route-fallback" @key="fallback"><span class="fallback-label">Fallback @(route.Fallbacks.IndexOf(fallback) + 1)</span><MudSelect T="Guid" @bind-Value="fallback.Provider" Label="Provider" Variant="Variant.Outlined">@foreach (var provider in workspace.Providers) { <MudSelectItem T="Guid" Value="provider.Id">@provider.Name</MudSelectItem> }</MudSelect><MudTextField @bind-Value="fallback.Model" Label="Model" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="fallback.Input" Min="0" Label="Input $ / 1M" Variant="Variant.Outlined" /><MudNumericField T="decimal?" @bind-Value="fallback.Output" Min="0" Label="Output $ / 1M" Variant="Variant.Outlined" /><button class="harness-button" @onclick="() => route.Fallbacks.Remove(fallback)" aria-label="Remove fallback">Remove</button></div>
                        }
                        <button class="harness-button route-add-fallback" @onclick="() => route.Fallbacks.Add(new())" disabled="@(route.Fallbacks.Count >= 3)">Add fallback to @(string.IsNullOrWhiteSpace(route.Stage) ? "route" : route.Stage)</button>
                    }
                    <button class="harness-button" @onclick="() => _routes.Add(new())" disabled="@(_routes.Count >= 32)">Add route</button>
                </section>
                <button class="harness-button primary" @onclick="SaveAsync" disabled="_busy">Save policy</button><span class="harness-revision">Revision @workspace.Policy.Revision</span>
            </MudTabPanel>
            <MudTabPanel Text="Skills" Icon="@Icons.Material.Outlined.AutoStories">
                <section class="harness-section"><h2>Pinned instructions</h2><p>Publishing creates an immutable business-owned revision. Select revisions and save the assignment to use them on future runs. Required capabilities must already be approved.</p>
                    @foreach (var skill in workspace.Skills)
                    {
                        <article class="skill-card"><MudCheckBox T="bool" Value="@_skills.Contains(skill.Id)" ValueChanged="@(value => Pin(skill.Id, value))" Disabled="@(!skill.Enabled)" Label="@($"{skill.Name} · v{skill.Version}{(!skill.Enabled ? " · disabled" : "")}")" /><code>@skill.Digest</code><details><summary>Read instructions</summary><pre>@skill.Instructions</pre><p>Requires: @string.Join(", ", skill.RequiredCapabilities)</p></details>@if (skill.Enabled) { <button class="harness-button" @onclick="() => DisableAsync(skill.Id)" disabled="_busy">Disable revision</button> }</article>
                    }
                    <button class="harness-button primary" @onclick="SaveAsync" disabled="_busy">Save assignment</button>
                </section>
                <section class="harness-section"><h2>Publish a revision</h2><div class="harness-fields"><MudTextField @bind-Value="_name" Label="Skill name" Variant="Variant.Outlined" /><MudTextField @bind-Value="_capabilities" Label="Required capabilities (comma-separated)" Variant="Variant.Outlined" /></div><MudTextField @bind-Value="_instructions" Label="Instructions" Lines="8" Variant="Variant.Outlined" /><button class="harness-button" disabled="_busy" @onclick="PublishAsync">Publish revision</button></section>
            </MudTabPanel>
            <MudTabPanel Text="Judgments" Icon="@Icons.Material.Outlined.FactCheck">
                <section class="harness-section"><h2>Advisory judgments</h2><MudNumericField T="int" @bind-Value="_judgmentOutputTokens" Label="Judgment output-token limit" Min="64" Max="4096" Variant="Variant.Outlined" /><button class="harness-button" @onclick="SaveAsync" disabled="_busy">Save judgment limit</button><p>Configure a Judgment route to enable bounded evaluations. Code supplies the allowed choices; the platform rejects answers outside that set. Judgments are recorded with model usage and never approve operations or expand capabilities.</p><p>Agents with the explicit <code>platform.harness.judge</code> grant can request an evaluation through their platform tools. The selected model uses the same provider authorization and task budget as other inference.</p></section>
            </MudTabPanel>
        </MudTabs>
    }
    else if (_busy) { <MudProgressLinear Indeterminate="true" /> }
</main>
@code {
    [Parameter] public Guid InstallationId { get; set; }
    private WorkspaceResponse? _workspace;
    private string? _error, _notice;
    private bool _busy, _compact;
    private int _judgmentOutputTokens = 512;
    private long? _tokens;
    private decimal? _cost;
    private string _name = "", _instructions = "", _capabilities = "";
    private readonly List<RouteEditor> _routes = [];
    private readonly HashSet<Guid> _skills = [];
    private sealed class RouteEditor { public string Stage { get; set; } = "Default"; public Guid Provider { get; set; } public string Model { get; set; } = ""; public decimal? Input { get; set; } public decimal? Output { get; set; } public List<TargetEditor> Fallbacks { get; } = []; }
    private sealed class TargetEditor { public Guid Provider { get; set; } public string Model { get; set; } = ""; public decimal? Input { get; set; } public decimal? Output { get; set; } }
    protected override Task OnParametersSetAsync() => LoadAsync();
    private bool _changedElsewhere;
    protected override void OnInitialized() => Realtime.EventReceived += OnRealtime;
    public void Dispose() => Realtime.EventReceived -= OnRealtime;
    // Realtime is a wake hint: re-read, and flag only a real difference so this page's own saves stay quiet.
    private void OnRealtime(CSweet.Contracts.Realtime.AppRealtimeEventEnvelope message)
    {
        if (message.EventType != CSweet.Contracts.Realtime.AppRealtimeEvents.HarnessChanged || message.Subject != InstallationId.ToString("D")) return;
        _ = InvokeAsync(async () =>
        {
            if (_workspace is null || _busy) return;
            try
            {
                var current = await Http.GetFromJsonAsync<WorkspaceResponse>($"api/agents/{InstallationId:D}/harness");
                if (current is null || _workspace is null) return;
                _changedElsewhere = current.Policy.Revision != _workspace.Policy.Revision ||
                    !current.Skills.Select(x => (x.Id, x.Enabled)).SequenceEqual(_workspace.Skills.Select(x => (x.Id, x.Enabled)));
                StateHasChanged();
            }
            catch (HttpRequestException) { }
        });
    }
    private void Pin(Guid id, bool value) { if (value) _skills.Add(id); else _skills.Remove(id); }
    private async Task LoadAsync()
    {
        _busy = true; _error = null; _changedElsewhere = false;
        try {
            _workspace = await Http.GetFromJsonAsync<WorkspaceResponse>($"api/agents/{InstallationId:D}/harness");
            if (_workspace is { } w) {
                _judgmentOutputTokens = w.Policy.JudgmentOutputTokens; _compact = w.Policy.CompactContext; _tokens = w.Policy.TaskTokenLimit; _cost = w.Policy.TaskCostLimit;
                _routes.Clear();
                foreach (var x in w.Policy.Routes ?? [])
                {
                    var editor = new RouteEditor { Stage = x.Stage, Provider = x.ProviderId, Model = x.Model, Input = x.InputPricePerMillion, Output = x.OutputPricePerMillion };
                    editor.Fallbacks.AddRange((x.Fallbacks ?? []).Select(f => new TargetEditor { Provider = f.ProviderId, Model = f.Model, Input = f.InputPricePerMillion, Output = f.OutputPricePerMillion }));
                    _routes.Add(editor);
                }
                _skills.Clear(); _skills.UnionWith(w.Policy.SkillRevisionIds ?? []);
            }
        } catch (HttpRequestException) { _workspace = null; _error = "This workspace is unavailable or you do not have permission to manage this agent."; }
        finally { _busy = false; }
    }
    private async Task SaveAsync()
    {
        if (_workspace is null) return;
        if (_routes.Any(x => x.Provider == Guid.Empty || x.Fallbacks.Any(f => f.Provider == Guid.Empty))) { _error = "Select a provider for every route and fallback."; return; }
        var policy = new HarnessPolicy(_workspace.Policy.Revision, _compact, _tokens, _cost,
            _routes.Select(x => new HarnessRoute(x.Stage.Trim(), x.Provider, x.Model.Trim(), x.Input, x.Output,
                x.Fallbacks.Count == 0 ? null : x.Fallbacks.Select(f => new HarnessRouteTarget(f.Provider, f.Model.Trim(), f.Input, f.Output)).ToArray())).ToArray(),
            _skills.ToArray(), _judgmentOutputTokens);
        await Mutate(async () => await Http.PutAsJsonAsync($"api/agents/{InstallationId:D}/harness", new SaveHarnessPolicy(_workspace.Policy.Revision, policy)), "Policy saved.");
    }
    private Task PublishAsync() => Mutate(async () => await Http.PostAsJsonAsync($"api/agents/{InstallationId:D}/harness/skills", new PublishHarnessSkill(_name, _instructions, _capabilities.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))), "Skill revision published. Select it to assign it.");
    private Task DisableAsync(Guid id) => Mutate(() => Http.DeleteAsync($"api/agents/{InstallationId:D}/harness/skills/{id:D}"), "Revision disabled. Review affected assignments before the next run.");
    private async Task Mutate(Func<Task<HttpResponseMessage>> action, string notice)
    {
        _busy = true; _error = null; _notice = null;
        try { using var response = await action(); if (!response.IsSuccessStatusCode) { var failure = response.Content.Headers.ContentType?.MediaType == "application/json" ? await response.Content.ReadFromJsonAsync<Dictionary<string, string>>() : null; _error = failure?.GetValueOrDefault("error") ?? "The change could not be saved."; return; } await LoadAsync(); _notice = notice; }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException) { _error = "The change could not be saved. Refresh before retrying."; }
        finally { _busy = false; }
    }
}
